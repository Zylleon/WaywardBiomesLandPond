<?xml version="1.0" encoding="utf-8"?>
<Defs>


	<BiomeDef>
		<defName>ZWB_LotusWilds</defName>
		<label>lotus wilds</label>
		<description>Groves of towering giant lotus plants, interspersed with reeds and grasses. Schools of land-adapted fish and other freshwater creatures wander through the foliage here.</description>
		<texture>ZWB_Textures/LotusWilds</texture>
		<!-- <workerClass>ZWBCore.BiomeWorker_Test</workerClass>  -->
		<workerClass>ZWB_LotusWilds.BiomeWorker_LotusWilds</workerClass>
		<settlementSelectionWeight>0.5</settlementSelectionWeight>
		<movementDifficulty>1.5</movementDifficulty>
		<animalDensity>4.3</animalDensity>
		<plantDensity>0.9</plantDensity>
		<wildPlantRegrowDays>12</wildPlantRegrowDays>
		<forageability>1</forageability>
		<foragedFood>ZWB_Watercress</foragedFood>
		<maxFishPopulation>600</maxFishPopulation>
		<!-- <wildPlantsCareAboutLocalFertility>false</wildPlantsCareAboutLocalFertility> -->
		<fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
			<freshwater_Common>
				<Fish_Salmon MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Salmon>
				<Fish_Bass MayRequire="Ludeon.RimWorld.Odyssey">0.5</Fish_Bass>
			</freshwater_Common>
			<freshwater_Uncommon>
				<Fish_Catfish MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Catfish>
			</freshwater_Uncommon>
			<saltwater_Common>
				<Fish_Salmon MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Salmon>
				<Fish_Bluefish MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Bluefish>
			</saltwater_Common>
			<saltwater_Uncommon>
				<Fish_Tuna MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Tuna>
				<Fish_Dogfish MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Dogfish>
			</saltwater_Uncommon>
			<rareCatchesSetMaker MayRequire="Ludeon.RimWorld.Odyssey">RareFishingCatches_Temperate</rareCatchesSetMaker>
		</fishTypes>
		<soundsAmbient>
			<li>Ambient_NightInsects_Standard</li>
		</soundsAmbient>
		<diseaseMtbDays>50</diseaseMtbDays>
		<diseases>
			<li>
				<diseaseInc>Disease_Flu</diseaseInc>
				<commonality>100</commonality>
			</li>
			<li>
				<diseaseInc>Disease_Plague</diseaseInc>
				<commonality>100</commonality>
			</li>
			<li>
				<diseaseInc>Disease_GutWorms</diseaseInc>
				<commonality>50</commonality>
			</li>
			<li>
				<diseaseInc>Disease_FibrousMechanites</diseaseInc>
				<commonality>30</commonality>
			</li>
			<li>
				<diseaseInc>Disease_SensoryMechanites</diseaseInc>
				<commonality>30</commonality>
			</li>
			<li>
				<diseaseInc>Disease_MuscleParasites</diseaseInc>
				<commonality>50</commonality>
			</li>

			<li>
				<diseaseInc>Disease_AnimalFlu</diseaseInc>
				<commonality>100</commonality>
			</li>
			<li>
				<diseaseInc>Disease_AnimalPlague</diseaseInc>
				<commonality>100</commonality>
			</li>
			<li>
				<diseaseInc>Disease_OrganDecay</diseaseInc>
				<commonality>10</commonality>
			</li>
