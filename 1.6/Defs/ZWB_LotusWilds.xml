			<Plant_Reeds MayRequire="Ludeon.RimWorld.Odyssey">1.2</Plant_Reeds>
			<Plant_LilyPad MayRequire="Ludeon.RimWorld.Odyssey">0.1</Plant_LilyPad>
			<Plant_Lotus MayRequire="Ludeon.RimWorld.Odyssey">0.1</Plant_Lotus>
			
			
		</wildPlants>
		<wildAnimals>
			<!-- small grazers -->
			<ZWB_Dippet>1.0</ZWB_Dippet>
			<ZWB_Glurble>1.0</ZWB_Glurble>
			<ZWB_Skyfin>0.5</ZWB_Skyfin>
			<ZWB_Flupper>0.5</ZWB_Flupper>
			<ZWB_Suribora>1</ZWB_Suribora>
			<ZWB_LotusFrog>0.4</ZWB_LotusFrog>

			<Bullfrog MayRequire="Ludeon.RimWorld.Odyssey">0.2</Bullfrog>
			<Duck>0.1</Duck>
			<Tortoise>0.05</Tortoise>


			<!-- large grazers -->
			<ZWB_Wampler>1.0</ZWB_Wampler>
			<ZWB_Terrakoi>0.5</ZWB_Terrakoi><!-- hauler -->
			<ZWB_Catfish>1.0</ZWB_Catfish><!-- pack animal, very large -->

			<ColossusToad MayRequire="Ludeon.RimWorld.Odyssey">0.03</ColossusToad>


			<!-- scavengers -->
			<ZWB_HardbackedSnop>0.5</ZWB_HardbackedSnop><!-- smaller pack animal, fighter -->
			<ZWB_SnippySnop>0.4</ZWB_SnippySnop><!-- fighter -->


			<!-- predator/grazers -->
			<ZWB_GoldenGaup>0.2</ZWB_GoldenGaup>
			<ZWB_SpeckledGaup>0.2</ZWB_SpeckledGaup>


			<!-- predators -->
			<ZWB_Quet>0.1</ZWB_Quet><!-- mid sized -->
			<ZWB_Awanna>0.1</ZWB_Awanna><!-- pack animal, very large -->

			<Alligator MayRequire="Ludeon.RimWorld.Odyssey">0.05</Alligator>
			<BogHound MayRequire="Ludeon.RimWorld.Odyssey">0.025</BogHound>

		</wildAnimals>
