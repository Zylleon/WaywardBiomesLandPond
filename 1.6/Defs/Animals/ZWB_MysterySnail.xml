<?xml version="1.0" encoding="utf-8"?>
<Defs>



	<ThingDef ParentName="AnimalThingBase">
		<defName>ZWB_MysterySnail</defName>
		<label>mystery snail</label>
		<description>A small aquatic snail, adapted for land. Named for the mystery experienced when you find one in your fishtank.</description>
		<statBases>
			<MoveSpeed>2.6</MoveSpeed>
			<ComfyTemperatureMin>-30</ComfyTemperatureMin>
			<ComfyTemperatureMax>40</ComfyTemperatureMax>
			<MarketValue>40</MarketValue>
			<Wildness>0.5</Wildness>
			<!-- <LeatherAmount>11</LeatherAmount>	 -->
			<ArmorRating_Blunt>0.05</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.12</ArmorRating_Sharp>
		</statBases>
		<comps>
			<li Class="CompProperties_EggLayer">
				<eggUnfertilizedDef>ZWB_EggMysterySnailUnfertilized</eggUnfertilizedDef>
				<eggFertilizedDef>ZWB_EggMysterySnailFertilized</eggFertilizedDef>
				<eggFertilizationCountMax>1</eggFertilizationCountMax>
				<eggLayIntervalDays>6.0</eggLayIntervalDays>
				<eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
				<eggCountRange>1~2</eggCountRange>
			</li>
		</comps>
		<race>
			<body>ZWB_SnailLike</body>
			<herdAnimal>true</herdAnimal>
			<baseBodySize>0.45</baseBodySize>
			<baseHungerRate>0.2</baseHungerRate>
			<baseHealthScale>0.5</baseHealthScale>
			<foodType>OmnivoreRoughAnimal</foodType>
			<trainability>None</trainability>
			<meatLabel>snail meat</meatLabel>
			<lifeExpectancy>6</lifeExpectancy>
			<!-- <petness>0.8</petness> -->
			<!-- <nuzzleMtbHours>24</nuzzleMtbHours> -->
			<leatherDef>ZWB_LoticChitin</leatherDef>
			<lifeStageAges>
				<li>
					<def>AnimalBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>AnimalJuvenile</def>
					<minAge>0.08</minAge>
				</li>
				<li>
					<def>AnimalAdult</def>
					<minAge>0.18</minAge>
					<!-- <soundWounded>Pawn_Boomrat_Wounded</soundWounded> -->
					<!-- <soundDeath>Pawn_Boomrat_Death</soundDeath> -->
					<!-- <soundCall>Pawn_Boomrat_Call</soundCall> -->
					<!-- <soundAngry>Pawn_Boomrat_Angry</soundAngry> -->
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
			<soundEating>Rodent_Eat</soundEating>
			<packAnimal>false</packAnimal>
		</race>
		<tradeTags>
			<li>AnimalCommon</li>
		</tradeTags>
		<tools>
			<li>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>6</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<chanceFactor>0.7</chanceFactor>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>6</power>
				<cooldownTime>1.8</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.2</chanceFactor>
			</li>
		</tools>
	</ThingDef>


