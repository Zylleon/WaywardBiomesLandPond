		<defName>ZWB_EggMysterySnailUnfertilized</defName>
		<label>mystery snail egg (unfert.)</label>
		<description>An unfertilized mystery snail egg. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(112,105,59)</color>
			<drawSize>0.7</drawSize>
		</graphicData>
		<statBases>
			<MarketValue>10.0</MarketValue>
			<Nutrition>0.5</Nutrition>
		</statBases>
	</ThingDef>


