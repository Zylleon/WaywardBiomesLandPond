	<ThingDef ParentName="EggFertBase">
		<defName>ZWB_EggMysterySnailFertilized</defName>
		<label>mystery snail egg (fert.)</label>
		<description>A fertilized mystery snail egg. If all goes well, it should hatch into a baby mystery snail. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(161,150,67)</color>
			<drawSize>0.7</drawSize>
		</graphicData>
		<statBases>
			<Nutrition>0.5</Nutrition>
			<MarketValue>16.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>5</hatcherDaystoHatch>
				<hatcherPawn>ZWB_MysterySnail</hatcherPawn>
			</li>
		</comps>
	</ThingDef>



