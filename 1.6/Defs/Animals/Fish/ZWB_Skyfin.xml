			<li>			<!-- dark body mid fin -->
				<texPath>ZWB_Textures/Animals/Skyfin/SkyfinA</texPath>
				<weight>1</weight>
			</li>
			<li>			<!-- light body mid fin -->
				<texPath>ZWB_Textures/Animals/Skyfin/SkyfinB</texPath>
				<weight>1</weight>
			</li>
		</alternateGraphics>
	</PawnKindDef>



	<ThingDef ParentName="EggFertBase">
		<defName>ZWB_EggSkyfinFertilized</defName>
		<label>skyfin egg (fert.)</label>
		<description>A fertilized skyfin egg. If all goes well, it should hatch into a baby skyfin. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(145,173,189)</color>
			<drawSize>0.7</drawSize>
		</graphicData>
		<statBases>
			<Nutrition>0.5</Nutrition>
			<MarketValue>16.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>5</hatcherDaystoHatch>
				<hatcherPawn>ZWB_Skyfin</hatcherPawn>
			</li>
		</comps>
	</ThingDef>



	<ThingDef ParentName="EggUnfertBase">
		<defName>ZWB_EggSkyfinUnfertilized</defName>
		<label>skyfin egg (unfert.)</label>
		<description>An unfertilized skyfin egg. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(125,144,156)</color>
			<drawSize>0.7</drawSize>
		</graphicData>
		<statBases>
			<MarketValue>9.0</MarketValue>
			<Nutrition>0.5</Nutrition>
		</statBases>
	</ThingDef>


</Defs>

