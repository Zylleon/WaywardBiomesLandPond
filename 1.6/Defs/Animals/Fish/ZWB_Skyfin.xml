<?xml version="1.0" encoding="utf-8"?>
<Defs>



	<ThingDef ParentName="AnimalThingBase">
		<defName>ZWB_Skyfin</defName>
		<label>skyfin</label>
		<description>PLACEHOLDER - medium-small herbivore.</description>
		<statBases>
			<MoveSpeed>4.0</MoveSpeed>
			<ComfyTemperatureMin>-25</ComfyTemperatureMin>
			<ComfyTemperatureMax>50</ComfyTemperatureMax>
			<MarketValue>190</MarketValue>
			<Wildness>0.1</Wildness>
		</statBases>
		<comps>
			<li Class="CompProperties_EggLayer">
				<eggUnfertilizedDef>ZWB_EggSkyfinUnfertilized</eggUnfertilizedDef>
				<eggFertilizedDef>ZWB_EggSkyfinFertilized</eggFertilizedDef>
				<eggFertilizationCountMax>1</eggFertilizationCountMax>
				<eggLayIntervalDays>5.6</eggLayIntervalDays>
				<eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
				<eggCountRange>1~1</eggCountRange>
			</li>
		</comps>
		<race>
			<body>ZWB_QuadrupedLandFish</body>
			<herdAnimal>true</herdAnimal>
			<baseBodySize>0.6</baseBodySize>
			<baseHungerRate>0.15</baseHungerRate>
			<baseHealthScale>0.7</baseHealthScale>
			<foodType>VegetarianRoughAnimal</foodType>
			<leatherDef>ZWB_Leather_SiltSkin</leatherDef>
			<roamMtbDays>2</roamMtbDays>
			<trainability>None</trainability>
			<manhunterOnTameFailChance>0.02</manhunterOnTameFailChance>
			<manhunterOnDamageChance>0.1</manhunterOnDamageChance>
			<useMeatFrom>ZWB_Awanna</useMeatFrom>
			<lifeExpectancy>16</lifeExpectancy>
			<lifeStageAges>
				<li>
					<def>AnimalBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>AnimalJuvenile</def>
					<minAge>0.1</minAge>
				</li>
				<li>
					<def>AnimalAdult</def>
					<minAge>0.23</minAge>
					<soundWounded>ZWB_Melu_Wounded</soundWounded>
					<soundDeath>ZWB_Melu_Death</soundDeath>
					<soundCall>ZWB_Melu_Call</soundCall>
					<soundAngry>ZWB_Melu_Angry</soundAngry>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
			<soundEating>Herbivore_Eat</soundEating>
			<packAnimal>false</packAnimal>
		</race>
		<tradeTags>
			<li>AnimalCommon</li>
		</tradeTags>
		<tools>
			<li>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>8</power>
				<cooldownTime>2.0</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<chanceFactor>0.7</chanceFactor>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>5.5</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.2</chanceFactor>
			</li>
			<li>
				<label>left flipper</label>
				<labelNoLocation>flipper</labelNoLocation>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>6</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>ZWB_FrontLeftFlipper</linkedBodyPartsGroup>
			</li>
			<li>
				<label>right flipper</label>
				<labelNoLocation>flipper</labelNoLocation>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>6</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>ZWB_FrontRightFlipper</linkedBodyPartsGroup>
			</li>
		</tools>
	</ThingDef>


	<PawnKindDef ParentName="AnimalKindBase">
		<defName>ZWB_Skyfin</defName>
		<label>skyfin</label>
		<race>ZWB_Skyfin</race>
		<combatPower>40</combatPower>
		<ecoSystemWeight>0.4</ecoSystemWeight>
		<wildGroupSize>2~5</wildGroupSize>
		<lifeStages>
			<li>
				<label>skyfin fry</label>
				<labelPlural>skyfin fry</labelPlural>
				<bodyGraphicData>
					<texPath>ZWB_Textures/Animals/Skyfin/Skyfin</texPath>
					<drawSize>0.7</drawSize>
				</bodyGraphicData>
				<dessicatedBodyGraphicData>
					<texPath>ZWB_Textures/Animals/Skyfin/Dessicated_Skyfin</texPath>
					<drawSize>0.7</drawSize>
				</dessicatedBodyGraphicData>
			</li>
			<li>
				<bodyGraphicData>
					<texPath>ZWB_Textures/Animals/Skyfin/Skyfin</texPath>
					<drawSize>1.0</drawSize>
					<shadowData>
						<volume>(0.25, 0.3, 0.25)</volume>
						<offset>(0,0,-0.15)</offset>
					</shadowData>
				</bodyGraphicData>
				<dessicatedBodyGraphicData>
					<texPath>ZWB_Textures/Animals/Skyfin/Dessicated_Skyfin</texPath>
					<drawSize>1.0</drawSize>
				</dessicatedBodyGraphicData>
			</li>
			<li>
				<bodyGraphicData>
					<texPath>ZWB_Textures/Animals/Skyfin/Skyfin</texPath>
					<drawSize>1.3</drawSize>
					<shadowData>
						<volume>(0.3, 0.4, 0.3)</volume>
						<offset>(0,0,-0.15)</offset>
					</shadowData>
				</bodyGraphicData>
				<dessicatedBodyGraphicData>
					<texPath>ZWB_Textures/Animals/Skyfin/Dessicated_Skyfin</texPath>
