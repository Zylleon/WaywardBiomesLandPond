	<ThingDef ParentName="EggFertBase">
		<defName>ZWB_EggSpeckledGaupFertilized</defName>
		<label>speckled gaup egg (fert.)</label>
		<description>A fertilized speckled gaup egg. If all goes well, it should hatch into a baby speckled gaup. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(115,122,66)</color>
			<drawSize>1.1</drawSize>
		</graphicData>
		<statBases>
			<Nutrition>0.5</Nutrition>
			<MarketValue>26.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>6</hatcherDaystoHatch>
				<hatcherPawn>ZWB_SpeckledGaup</hatcherPawn>
			</li>
		</comps>
	</ThingDef>



