	<ThingDef ParentName="EggFertBase">
		<defName>ZWB_EggAwannaFertilized</defName>
		<label>awanna egg (fert.)</label>
		<description>A fertilized awanna egg. If all goes well, it should hatch into a baby awanna. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(151,138,127)</color>
			<drawSize>1.6</drawSize>
		</graphicData>
		<!-- <uiIconScale>0.666</uiIconScale> -->
		<statBases>
			<Nutrition>0.5</Nutrition>
			<MarketValue>58.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>9</hatcherDaystoHatch>
				<hatcherPawn>ZWB_Awanna</hatcherPawn>
			</li>
		</comps>
	</ThingDef>



	<ThingDef ParentName="EggUnfertBase">
		<defName>ZWB_EggAwannaUnfertilized</defName>
		<label>awanna egg (unfert.)</label>
		<description>An unfertilized awanna egg. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggOval</texPath>
			<color>(134,126,20)</color>
			<drawSize>1.6</drawSize>
		</graphicData>
		<uiIconScale>0.666</uiIconScale>
		<statBases>
			<MarketValue>17.0</MarketValue>
			<Nutrition>0.5</Nutrition>
		</statBases>
	</ThingDef>




