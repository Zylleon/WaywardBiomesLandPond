<?xml version="1.0" encoding="utf-8"?>
<Defs>



	<ThingDef ParentName="AnimalThingBase">
		<defName>ZWB_Awanna</defName>
		<label>awanna</label>
		<description>PLACEHOLDER: A huge predatory fish. Solitary. Many colors. Intermediate trainability.Pack animal.</description>
		<statBases>
			<MoveSpeed>5.5</MoveSpeed>
			<ComfyTemperatureMin>-30</ComfyTemperatureMin>
			<ComfyTemperatureMax>45</ComfyTemperatureMax>
			<MarketValue>660</MarketValue>
			<Wildness>0.9</Wildness>
		</statBases>
		<comps>
			<li Class="CompProperties_EggLayer">
				<eggUnfertilizedDef>ZWB_EggAwannaUnfertilized</eggUnfertilizedDef>
				<eggFertilizedDef>ZWB_EggAwannaFertilized</eggFertilizedDef>
				<eggFertilizationCountMax>1</eggFertilizationCountMax>
				<eggLayIntervalDays>12</eggLayIntervalDays>
				<eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
				<eggCountRange>1~2</eggCountRange>
			</li>
		</comps>
		<race>
			<body>ZWB_QuadrupedLandFish</body>
			<herdAnimal>false</herdAnimal>
			<!-- <maxPreyBodySize>2.1</maxPreyBodySize> -->
			<baseBodySize>3.5</baseBodySize>
			<baseHungerRate>0.4</baseHungerRate>
			<baseHealthScale>4.0</baseHealthScale>
			<foodType>CarnivoreAnimal</foodType>
			<leatherDef>Leather_Plain</leatherDef>
			<trainability>Intermediate</trainability>
			<!-- <useMeatFrom>ZWB_Jesterfish</useMeatFrom> -->
			<lifeExpectancy>34</lifeExpectancy>
			<!-- <petness>0.5</petness> -->
			<!-- <nuzzleMtbHours>36</nuzzleMtbHours> -->
			<manhunterOnTameFailChance>0.10</manhunterOnTameFailChance>
			<manhunterOnDamageChance>0.8</manhunterOnDamageChance>
			<specialTrainables>
				<li MayRequire="Ludeon.RimWorld.Odyssey">AttackTarget</li>
			</specialTrainables>
			<lifeStageAges>
				<li>
					<def>AnimalBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>AnimalJuvenile</def>
					<minAge>0.38</minAge>
				</li>
				<li>
					<def>AnimalAdult</def>
					<minAge>0.65</minAge>
					<soundWounded>ZWB_Ziggler_Wounded</soundWounded>
					<soundDeath>ZWB_Ziggler_Death</soundDeath>
					<soundCall>ZWB_Ziggler_Call</soundCall>
					<soundAngry>ZWB_Ziggler_Angry</soundAngry>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
			<soundEating>PredatorSmall_Eat</soundEating>
			<packAnimal>false</packAnimal>
			<predator>true</predator>

		</race>
		<tradeTags>
			<li>AnimalUncommon</li>
			<li>AnimalFighter</li>
		</tradeTags>
		<tools>
			<li>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>28</power>
				<cooldownTime>1.9</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<chanceFactor>0.7</chanceFactor>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>14</power>
				<cooldownTime>2.2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.2</chanceFactor>
				<surpriseAttack>
					<extraMeleeDamages>
						<li>
							<def>Stun</def>
							<amount>26</amount>
						</li>
					</extraMeleeDamages>
				</surpriseAttack>
			</li>
			<li>
				<label>left flipper</label>
				<labelNoLocation>flipper</labelNoLocation>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>18</power>
				<cooldownTime>2.2</cooldownTime>
				<linkedBodyPartsGroup>ZWB_FrontLeftFlipper</linkedBodyPartsGroup>
				<surpriseAttack>
					<extraMeleeDamages>
						<li>
							<def>Stun</def>
							<amount>22</amount>
						</li>
					</extraMeleeDamages>
				</surpriseAttack>
			</li>
			<li>
				<label>right flipper</label>
				<labelNoLocation>flipper</labelNoLocation>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>18</power>
				<cooldownTime>2.2</cooldownTime>
				<linkedBodyPartsGroup>ZWB_FrontRightFlipper</linkedBodyPartsGroup>
				<surpriseAttack>
					<extraMeleeDamages>
						<li>
							<def>Stun</def>
							<amount>22</amount>
						</li>
					</extraMeleeDamages>
				</surpriseAttack>
			</li>
		</tools>
	</ThingDef>


