	<ThingDef ParentName="EggFertBase">
		<defName>ZWB_EggQuetFertilized</defName>
		<label>quet egg (fert.)</label>
		<description>A fertilized quet egg. If all goes well, it should hatch into a baby quet. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(153,161,77)</color>
			<drawSize>1.1</drawSize>
		</graphicData>
		<!-- <uiIconScale>0.666</uiIconScale> -->
		<statBases>
			<Nutrition>0.5</Nutrition>
			<MarketValue>24.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>6</hatcherDaystoHatch>
				<hatcherPawn>ZWB_Quet</hatcherPawn>
			</li>
		</comps>
	</ThingDef>



	<ThingDef ParentName="EggUnfertBase">
		<defName>ZWB_EggQuetUnfertilized</defName>
		<label>quet egg (unfert.)</label>
		<description>An unfertilized quet egg. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggOval</texPath>
			<color>(115,122,66)</color>
			<drawSize>1.1</drawSize>
		</graphicData>
		<uiIconScale>0.666</uiIconScale>
		<statBases>
			<MarketValue>12.0</MarketValue>
			<Nutrition>0.5</Nutrition>
		</statBases>
	</ThingDef>




