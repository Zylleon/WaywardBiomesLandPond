	<ThingDef ParentName="EggFertBase">
		<defName>ZWB_EggSuriboraFertilized</defName>
		<label>suribora egg (fert.)</label>
		<description>A fertilized suribora egg. If all goes well, it should hatch into a baby suribora. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggBirdSmall</texPath>
			<color>(204,127,105)</color>
			<drawSize>0.7</drawSize>
		</graphicData>
		<statBases>
			<Nutrition>0.5</Nutrition>
			<MarketValue>16.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>5</hatcherDaystoHatch>
				<hatcherPawn>ZWB_Suribora</hatcherPawn>
			</li>
		</comps>
	</ThingDef>



	<ThingDef ParentName="EggUnfertBase">
		<defName>ZWB_EggSuriboraUnfertilized</defName>
		<label>suribora egg (unfert.)</label>
		<description>An unfertilized suribora egg. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggBirdSmall</texPath>
			<color>(168,122,109)</color>
			<drawSize>0.7</drawSize>
		</graphicData>
		<statBases>
			<MarketValue>9.0</MarketValue>
			<Nutrition>0.5</Nutrition>
		</statBases>
	</ThingDef>


</Defs>

