	<ThingDef ParentName="EggFertBase">
		<defName>ZWB_EggCatfishFertilized</defName>
		<label>catfish egg (fert.)</label>
		<description>A fertilized catfish egg. If all goes well, it should hatch into a baby catfish. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(99,86,56)</color>
			<drawSize>1.35</drawSize>
		</graphicData>
		<uiIconScale>0.666</uiIconScale>
		<statBases>
			<Nutrition>0.5</Nutrition>
			<MarketValue>47.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>10</hatcherDaystoHatch>
				<hatcherPawn>ZWB_Catfish</hatcherPawn>
			</li>
		</comps>
	</ThingDef>



	<ThingDef ParentName="EggUnfertBase">
		<defName>ZWB_EggCatfishUnfertilized</defName>
		<label>catfish egg (unfert.)</label>
		<description>An unfertilized catfish egg. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggOval</texPath>
			<color>(75,68,50)</color>
			<drawSize>1.35</drawSize>
		</graphicData>
		<uiIconScale>0.666</uiIconScale>
		<statBases>
			<MarketValue>25.0</MarketValue>
			<Nutrition>0.5</Nutrition>
		</statBases>
	</ThingDef>


</Defs>

