	<ThingDef ParentName="EggFertBase">
		<defName>ZWB_EggGlurbleFertilized</defName>
		<label>glurble egg (fert.)</label>
		<description>A fertilized glurble egg. If all goes well, it should hatch into a baby glurble. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(117,102,69)</color>
			<drawSize>1.0</drawSize>
		</graphicData>
		<!-- <uiIconScale>0.666</uiIconScale> -->
		<statBases>
			<Nutrition>0.5</Nutrition>
			<MarketValue>22.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>6</hatcherDaystoHatch>
				<hatcherPawn>ZWB_Glurble</hatcherPawn>
			</li>
		</comps>
	</ThingDef>



