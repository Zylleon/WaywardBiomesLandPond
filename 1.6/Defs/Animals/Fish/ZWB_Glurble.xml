			<texPath>Things/Item/Resource/AnimalProductRaw/EggOval</texPath>
			<color>(94,85,65)</color>
			<drawSize>1.0</drawSize>
		</graphicData>
		<uiIconScale>0.666</uiIconScale>
		<statBases>
			<MarketValue>10.0</MarketValue>
			<Nutrition>0.5</Nutrition>
		</statBases>
	</ThingDef>


