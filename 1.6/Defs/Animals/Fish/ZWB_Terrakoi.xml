<?xml version="1.0" encoding="utf-8"?>
<Defs>



	<ThingDef ParentName="AnimalThingBase">
		<defName>ZWB_Terrakoi</defName>
		<label>terrakoi</label>
		<description>PLACEHOLDER: A mid sized fish. Good pet, hauler. Grazer, large schools. Low wildness.</description>
		<statBases>
			<MoveSpeed>4.8</MoveSpeed>
			<ComfyTemperatureMin>-30</ComfyTemperatureMin>
			<ComfyTemperatureMax>45</ComfyTemperatureMax>
			<MarketValue>300</MarketValue>
			<Wildness>0.05</Wildness>
		</statBases>
		<comps>
			<li Class="CompProperties_EggLayer">
				<eggUnfertilizedDef>ZWB_EggTerrakoiUnfertilized</eggUnfertilizedDef>
				<eggFertilizedDef>ZWB_EggTerrakoiFertilized</eggFertilizedDef>
				<eggFertilizationCountMax>1</eggFertilizationCountMax>
				<eggLayIntervalDays>6</eggLayIntervalDays>
				<eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
				<eggCountRange>1~2</eggCountRange>
			</li>
		</comps>
		<race>
			<body>ZWB_QuadrupedLandFish</body>
			<herdAnimal>true</herdAnimal>
			<!-- <maxPreyBodySize>2.1</maxPreyBodySize> -->
			<baseBodySize>0.9</baseBodySize>
			<baseHungerRate>0.27</baseHungerRate>
			<baseHealthScale>0.8</baseHealthScale>
			<foodType>VegetarianRoughAnimal</foodType>
			<leatherDef>Leather_Plain</leatherDef>
			<trainability>Advanced</trainability>
			<useMeatFrom>ZWB_Awanna</useMeatFrom>
			<lifeExpectancy>12</lifeExpectancy>
			<petness>0.5</petness>
			<nuzzleMtbHours>24</nuzzleMtbHours>
			<!-- <manhunterOnTameFailChance>0.20</manhunterOnTameFailChance> -->
			<!-- <manhunterOnDamageChance>0.5</manhunterOnDamageChance> -->
			<!-- <gestationPeriodDays>10</gestationPeriodDays> -->
			<specialTrainables>
				<li MayRequire="Ludeon.RimWorld.Odyssey">AttackTarget</li>
			</specialTrainables>
			<litterSizeCurve>
				<points>
					<li>(0.5, 0)</li>
					<li>(1, 1)</li>
					<li>(2, 1.7)</li>
					<li>(2.5, 0.7)</li>
					<li>(3, 0)</li>
				</points>
			</litterSizeCurve>
			<lifeStageAges>
				<li>
					<def>AnimalBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>AnimalJuvenile</def>
					<minAge>0.20</minAge>
				</li>
				<li>
					<def>AnimalAdult</def>
					<minAge>0.40</minAge>
					<soundWounded>ZWB_Jesterfish_Wounded</soundWounded>
					<soundDeath>ZWB_Jesterfish_Death</soundDeath>
					<soundCall>ZWB_Jesterfish_Call</soundCall>
					<soundAngry>ZWB_Jesterfish_Angry</soundAngry>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
			<soundEating>PredatorSmall_Eat</soundEating>
			<packAnimal>false</packAnimal>
			<predator>false</predator>

		</race>
		<tradeTags>
			<li>AnimalUncommon</li>
			<li>AnimalFighter</li>
		</tradeTags>
		<tools>
			<li>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>11</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<chanceFactor>0.7</chanceFactor>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>8</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.2</chanceFactor>
				<surpriseAttack>
					<extraMeleeDamages>
						<li>
							<def>Stun</def>
							<amount>11</amount>
						</li>
					</extraMeleeDamages>
				</surpriseAttack>
			</li>
			<li>
				<label>left flipper</label>
				<labelNoLocation>flipper</labelNoLocation>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>7</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>ZWB_FrontLeftFlipper</linkedBodyPartsGroup>
				<surpriseAttack>
					<extraMeleeDamages>
						<li>
							<def>Stun</def>
							<amount>10</amount>
						</li>
					</extraMeleeDamages>
				</surpriseAttack>
			</li>
			<li>
				<label>right flipper</label>
				<labelNoLocation>flipper</labelNoLocation>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>7</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>ZWB_FrontRightFlipper</linkedBodyPartsGroup>
				<surpriseAttack>
					<extraMeleeDamages>
						<li>
							<def>Stun</def>
							<amount>10</amount>
						</li>
					</extraMeleeDamages>
				</surpriseAttack>
			</li>
		</tools>
	</ThingDef>


