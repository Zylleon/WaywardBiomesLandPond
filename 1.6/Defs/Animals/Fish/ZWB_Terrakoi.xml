	<ThingDef ParentName="EggFertBase">
		<defName>ZWB_EggTerrakoiFertilized</defName>
		<label>terrakoi egg (fert.)</label>
		<description>A fertilized terrakoi egg. If all goes well, it should hatch into a baby terrakoi. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(184,144,66)</color>
			<drawSize>1.1</drawSize>
		</graphicData>
		<!-- <uiIconScale>0.666</uiIconScale> -->
		<statBases>
			<Nutrition>0.5</Nutrition>
			<MarketValue>24.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>6</hatcherDaystoHatch>
				<hatcherPawn>ZWB_Terrakoi</hatcherPawn>
			</li>
		</comps>
	</ThingDef>



	<ThingDef ParentName="EggUnfertBase">
		<defName>ZWB_EggTerrakoiUnfertilized</defName>
		<label>terrakoi egg (unfert.)</label>
		<description>An unfertilized terrakoi egg. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggOval</texPath>
			<color>(150,114,70)</color>
			<drawSize>1.1</drawSize>
		</graphicData>
		<uiIconScale>0.666</uiIconScale>
		<statBases>
			<MarketValue>12.0</MarketValue>
			<Nutrition>0.5</Nutrition>
		</statBases>
	</ThingDef>




</Defs>

