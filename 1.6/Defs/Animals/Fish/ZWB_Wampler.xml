	<ThingDef ParentName="EggFertBase">
		<defName>ZWB_EggWamplerFertilized</defName>
		<label>wampler egg (fert.)</label>
		<description>A fertilized wampler egg. If all goes well, it should hatch into a baby wampler. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(101,95,62)</color>
			<drawSize>1.2</drawSize>
		</graphicData>
		<statBases>
			<Nutrition>0.5</Nutrition>
			<MarketValue>28.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>6</hatcherDaystoHatch>
				<hatcherPawn>ZWB_Wampler</hatcherPawn>
			</li>
		</comps>
	</ThingDef>



