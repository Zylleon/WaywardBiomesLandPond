	<ThingDef ParentName="EggFertBase">
		<defName>ZWB_EggDippetFertilized</defName>
		<label>dippet egg (fert.)</label>
		<description>A fertilized dippet egg. If all goes well, it should hatch into a baby dippet. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(157,152,148)</color>
			<drawSize>0.7</drawSize>
		</graphicData>
		<statBases>
			<Nutrition>0.5</Nutrition>
			<MarketValue>16.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>5</hatcherDaystoHatch>
				<hatcherPawn>ZWB_Dippet</hatcherPawn>
			</li>
		</comps>
	</ThingDef>



	<ThingDef ParentName="EggUnfertBase">
		<defName>ZWB_EggDippetUnfertilized</defName>
		<label>dippet egg (unfert.)</label>
		<description>An unfertilized dippet egg. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(134,126,120)</color>
			<drawSize>0.7</drawSize>
		</graphicData>
		<statBases>
			<MarketValue>10.0</MarketValue>
			<Nutrition>0.5</Nutrition>
		</statBases>
	</ThingDef>


</Defs>
