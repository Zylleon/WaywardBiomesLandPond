				<dessicatedBodyGraphicData>
					<texPath>ZWB_Textures/Animals/Dippet/Dessicated_Dippet</texPath>
					<drawSize>0.35</drawSize>
				</dessicatedBodyGraphicData>
			</li>
			<li>
				<bodyGraphicData>
					<texPath>ZWB_Textures/Animals/Dippet/Dippet</texPath>
					<drawSize>0.65</drawSize>
				</bodyGraphicData>
				<dessicatedBodyGraphicData>
					<texPath>ZWB_Textures/Animals/Dippet/Dessicated_Dippet</texPath>
					<drawSize>0.65</drawSize>
				</dessicatedBodyGraphicData>
			</li>
			<li>
				<bodyGraphicData>
					<texPath>ZWB_Textures/Animals/Dippet/Dippet</texPath>
					<drawSize>0.85</drawSize>
				</bodyGraphicData>
				<dessicatedBodyGraphicData>
					<texPath>ZWB_Textures/Animals/Dippet/Dessicated_Dippet</texPath>
