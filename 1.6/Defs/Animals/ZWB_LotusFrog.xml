<?xml version="1.0" encoding="utf-8"?>
<Defs>



	<ThingDef ParentName="AnimalThingBase">
		<defName>ZWB_LotusFrog</defName>
		<label>lotus frog</label>
		<description>PLACEHOLDER: Small frog that lives among the lotuses.</description>
		<statBases>
			<MoveSpeed>4.0</MoveSpeed>
			<ComfyTemperatureMin>-10</ComfyTemperatureMin>
			<ComfyTemperatureMax>40</ComfyTemperatureMax>
			<MarketValue>40</MarketValue>
			<Wildness>0.25</Wildness>
		</statBases>
		<comps>
			<li Class="CompProperties_EggLayer">
				<eggUnfertilizedDef>ZWB_EggLotusFrogUnfertilized</eggUnfertilizedDef>
				<eggFertilizedDef>ZWB_EggLotusFrogFertilized</eggFertilizedDef>
				<eggFertilizationCountMax>1</eggFertilizationCountMax>
				<eggLayIntervalDays>4.7</eggLayIntervalDays>
				<eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
				<eggCountRange>1~1</eggCountRange>
			</li>
		</comps>
		<race>
			<body>QuadrupedAnimalWithPaws</body>
			<herdAnimal>false</herdAnimal>
			<baseBodySize>0.25</baseBodySize>
			<baseHungerRate>0.11</baseHungerRate>
			<baseHealthScale>0.32</baseHealthScale>
			<foodType>OmnivoreRoughAnimal</foodType>
			<!-- <useMeatFrom>ZWB_Awanna</useMeatFrom> -->
			<leatherDef>ZWB_Leather_SiltSkin</leatherDef>
			<trainability>None</trainability>
			<lifeExpectancy>9</lifeExpectancy>
			<lifeStageAges>
				<li>
					<def>AnimalBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>AnimalJuvenile</def>
					<minAge>0.12</minAge>
				</li>
				<li>
					<def>AnimalAdult</def>
					<minAge>0.25</minAge>
					<soundWounded>ZWB_SmallFrog_Wounded</soundWounded>
					<soundDeath>ZWB_SmallFrog_Death</soundDeath>
					<soundCall>ZWB_SmallFrog_Call</soundCall>
					<soundAngry>ZWB_SmallFrog_Angry</soundAngry>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
			<soundEating>Rodent_Eat</soundEating>
			<packAnimal>false</packAnimal>
		</race>
		<tradeTags>
			<li>AnimalUncommon</li>
		</tradeTags>
		<tools>
			<li>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>4</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<chanceFactor>0.7</chanceFactor>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>2.2</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.2</chanceFactor>
			</li>
		</tools>
	</ThingDef>


