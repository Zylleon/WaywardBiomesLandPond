<Defs>



	<ThingDef ParentName="AnimalThingBase">
		<defName>ZWB_RiverOtter</defName>
		<label>river otter</label>
		<description>A playful creature found in and near freshwater. They use tools such as rocks to crack open shellfish.</description>
		<statBases>
			<MoveSpeed>3.7</MoveSpeed>
			<MarketValue>75</MarketValue>
			<ComfyTemperatureMin>-30</ComfyTemperatureMin>
			<Wildness>0.4</Wildness>
		</statBases>
		<tools>
			<li>
				<label>left claw</label>
				<labelNoLocation>claw</labelNoLocation>
				<capacities>
					<li>Scratch</li>
				</capacities>
				<power>5.0</power>
				<cooldownTime>1.5</cooldownTime>
				<linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
			</li>
			<li>
				<label>right claw</label>
				<labelNoLocation>claw</labelNoLocation>
				<capacities>
					<li>Scratch</li>
				</capacities>
				<power>5.0</power>
				<cooldownTime>1.5</cooldownTime>
				<linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
			</li>
			<li>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<chanceFactor>0.7</chanceFactor>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>4</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.2</chanceFactor>
				<surpriseAttack>
				  <extraMeleeDamages>
					<li>
					  <def>Stun</def>
					  <amount>10</amount>
					</li>
				  </extraMeleeDamages>
				</surpriseAttack>
			</li>
		</tools>
		<race>
			<body>QuadrupedAnimalWithPaws</body>
			<baseBodySize>0.5</baseBodySize>
			<baseHungerRate>0.14</baseHungerRate>
			<baseHealthScale>0.55</baseHealthScale>
			<foodType>OmnivoreRoughAnimal</foodType>
			<herdAnimal>true</herdAnimal>
			<predator>true</predator>
			<leatherDef>Leather_Light</leatherDef>
			<trainability>Intermediate</trainability>
			<petness>0.75</petness>
			<manhunterOnTameFailChance>0.05</manhunterOnTameFailChance>
			<manhunterOnDamageChance>0.1</manhunterOnDamageChance>
			<gestationPeriodDays>5.7</gestationPeriodDays>
			<waterSeeker>true</waterSeeker>
			<waterCellCost>1</waterCellCost>
			<soundEating>Rodent_Eat</soundEating>
			<litterSizeCurve>
				<points>
					<li>(0.5, 0)</li>
					<li>(1, 1)</li>
					<li>(2.2, 1)</li>
					<li>(2.8, 0)</li>
				</points>
			</litterSizeCurve>
			<lifeExpectancy>10</lifeExpectancy>
			<lifeStageAges>
				<li>
					<def>AnimalBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>AnimalJuvenile</def>
					<minAge>0.12</minAge>
				</li>
				<li>
					<def>AnimalAdult</def>
					<minAge>0.25</minAge>
					<!-- <soundWounded>Pawn_Otter_Wounded</soundWounded> -->
					<!-- <soundDeath>Pawn_Otter_Death</soundDeath> -->
					<!-- <soundCall>Pawn_Otter_Call</soundCall> -->
					<!-- <soundAngry>Pawn_Otter_Angry</soundAngry> -->
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
		</race>
		<tradeTags>
			<li>AnimalUncommon</li>
		</tradeTags>
