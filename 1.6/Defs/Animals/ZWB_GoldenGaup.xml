	<ThingDef ParentName="EggFertBase">
		<defName>ZWB_EggGoldenGaupFertilized</defName>
		<label>golden gaup egg (fert.)</label>
		<description>A fertilized golden gaup egg. If all goes well, it should hatch into a baby golden gaup. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
			<color>(186,173,71)</color>
			<drawSize>0.8</drawSize>
		</graphicData>
		<statBases>
			<Nutrition>0.5</Nutrition>
			<MarketValue>17.0</MarketValue>
		</statBases>
		<comps>
			<li Class="CompProperties_Hatcher">
				<hatcherDaystoHatch>6</hatcherDaystoHatch>
				<hatcherPawn>ZWB_GoldenGaup</hatcherPawn>
			</li>
		</comps>
	</ThingDef>



	<ThingDef ParentName="EggUnfertBase">
		<defName>ZWB_EggGoldenGaupUnfertilized</defName>
		<label>golden gaup egg (unfert.)</label>
		<description>An unfertilized golden gaup egg. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<texPath>Things/Item/Resource/AnimalProductRaw/EggOval</texPath>
			<color>(150,141,78)</color>
			<drawSize>0.8</drawSize>
		</graphicData>
		<statBases>
			<MarketValue>8.0</MarketValue>
			<Nutrition>0.5</Nutrition>
		</statBases>
	</ThingDef>




</Defs>

