<Defs>



	<ThingDef ParentName="AnimalThingBase">
		<defName>ZWB_SnippySnop</defName>
		<label>snippy snop</label>
		<description>A small, aggressive crayfish. Quite wild, but makes a good attack animal once trained.</description>
		<statBases>
			<MoveSpeed>4.8</MoveSpeed>
			<ComfyTemperatureMin>-30</ComfyTemperatureMin>
			<ComfyTemperatureMax>40</ComfyTemperatureMax>
			<MarketValue>190</MarketValue>
			<Wildness>0.9</Wildness>
			<!-- <LeatherAmount>13</LeatherAmount> -->
			<ArmorRating_Blunt>0.15</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.3</ArmorRating_Sharp>
		</statBases>

		<race>
			<body>ZWB_LobsterLike</body>
			<herdAnimal>true</herdAnimal>
			<baseBodySize>0.3</baseBodySize>
			<baseHungerRate>0.2</baseHungerRate>
			<baseHealthScale>0.4</baseHealthScale>
			<foodType>OmnivoreAnimal</foodType>
			<trainability>Intermediate</trainability>
			<lifeExpectancy>5</lifeExpectancy>
			<useMeatFrom>ZWB_HardbackedSnop</useMeatFrom>
			<leatherDef>ZWB_LoticChitin</leatherDef>
			<gestationPeriodDays>3</gestationPeriodDays>
			<manhunterOnDamageChance>0.9</manhunterOnDamageChance>
			<manhunterOnTameFailChance>0.2</manhunterOnTameFailChance>
			<lifeStageAges>
				<li>
					<def>AnimalBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>AnimalJuvenile</def>
					<minAge>0.1</minAge>
				</li>
				<li>
					<def>AnimalAdult</def>
					<minAge>0.2</minAge>
					<soundWounded>ZWB_SmallCrab_Wounded</soundWounded>
					<soundDeath>ZWB_SmallCrab_Death</soundDeath>
					<soundCall>ZWB_SmallCrab_Call</soundCall>
					<soundAngry>ZWB_SmallCrab_Angry</soundAngry>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
			<soundEating>Rodent_Eat</soundEating>
			<packAnimal>false</packAnimal>
		</race>
		<tradeTags>
			<li>AnimalCommon</li>
			<li>AnimalFighter</li>
		</tradeTags>
		<tools>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>4</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.2</chanceFactor>
			</li>
			<li>
				<label>left claw</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>7.5</power>
				<cooldownTime>1.8</cooldownTime>
				<linkedBodyPartsGroup>ZWB_LeftClaw</linkedBodyPartsGroup>
				<chanceFactor>0.6</chanceFactor>
			</li>
			<li>
				<label>right claw</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>7.5</power>
				<cooldownTime>1.8</cooldownTime>
				<linkedBodyPartsGroup>ZWB_RightClaw</linkedBodyPartsGroup>
				<chanceFactor>0.6</chanceFactor>
			</li>
		</tools>
	</ThingDef>


