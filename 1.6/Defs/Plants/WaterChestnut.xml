<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="PlantBase">
		<defName>ZWB_WaterChestnutPlant</defName>
		<label>water chestnut</label>
		<description>A tall, grass-like plant with edible "nuts" growing underground.</description>
		<neverMultiSelect>false</neverMultiSelect>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<Nutrition>0.50</Nutrition>
		</statBases>
		<graphicData>
			<texPath>ZWB_Textures/Plants/WaterChestnut</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<selectable>true</selectable>
		<pathCost>12</pathCost>
		<ingestible/>
		<plant>
			<sowMinSkill>4</sowMinSkill>
			<dieIfLeafless>false</dieIfLeafless>
			<sowTags>
				<li>Ground</li>
				<li>Hydroponic</li>
			</sowTags>
			<mustBeWildToSow>true</mustBeWildToSow>
			<fertilityMin>0.05</fertilityMin>
			<fertilitySensitivity>0.8</fertilitySensitivity>
			<growDays>7.5</growDays>
			<immatureGraphicPath>ZWB_Textures/Plants/WaterChestnut_Immature</immatureGraphicPath>
			<harvestYield>14</harvestYield>
			<harvestWork>250</harvestWork>
			<!-- <maxMeshCount>9</maxMeshCount> -->
			<harvestTag>Standard</harvestTag>
			<harvestedThingDef>ZWB_WaterChestnuts</harvestedThingDef>
			<wildClusterRadius>5</wildClusterRadius>
			<wildClusterWeight>400</wildClusterWeight>
			<visualSizeRange>0.7~1.9</visualSizeRange>
			<topWindExposure>0.15</topWindExposure>
			<wildOrder>2</wildOrder>
			<purpose>Food</purpose>
			<humanFoodPlant>true</humanFoodPlant>
		</plant>
	</ThingDef>
	
	

  <ThingDef ParentName="PlantFoodRawBase">
    <defName>ZWB_WaterChestnuts</defName>
    <label>water chestnuts</label>
    <description>Crisp, crunchy vegetables with a slightly sweet taste. Can be eaten raw, but is better cooked.</description>
    <soundInteract>Grain_Drop</soundInteract>
    <soundDrop>Grain_Drop</soundDrop>
    <graphicData>
      <texPath>ZWB_Textures/Things/WaterChestnuts</texPath>
    </graphicData>
    <statBases>
      <MarketValue>1.1</MarketValue>
    </statBases>
    <ingestible>
      <foodType>VegetableOrFruit</foodType>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>40</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>
</Defs>

