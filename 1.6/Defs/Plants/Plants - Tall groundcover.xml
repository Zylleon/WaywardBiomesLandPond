<?xml version="1.0" encoding="utf-8"?>
<Defs>


	<ThingDef ParentName="PlantBase">
		<defName>ZWB_Greenflop</defName>
		<label>greenflop</label>
		<description>Descended from popular aquarium plants, these medium height plants have long green leaves on tall stems.</description>
		<statBases>
			<MaxHitPoints>110</MaxHitPoints>
			<Beauty>4</Beauty>
			<BeautyOutdoors>4</BeautyOutdoors>
			<Nutrition>0.5</Nutrition>
		</statBases>
		<pathCost>18</pathCost>
		<graphicData>
			<texPath>ZWB_Textures/Plants/Greenflop</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<selectable>true</selectable>
		<!-- <hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth> -->
		<ingestible/>
		<plant>
			<fertilitySensitivity>0.5</fertilitySensitivity>
			<growDays>3.5</growDays>
			<fertilityMin>0.05</fertilityMin>
			<!-- <maxMeshCount>9</maxMeshCount> -->
			<visualSizeRange>0.6~1.2</visualSizeRange>
			<topWindExposure>0.5</topWindExposure>
			<wildClusterRadius>4</wildClusterRadius>
			<wildClusterWeight>200</wildClusterWeight>
			<wildOrder>2</wildOrder>
		</plant>
	</ThingDef>




