<?xml version="1.0" encoding="utf-8"?>
<Defs>


	<ThingDef ParentName="PlantBase">
		<defName>ZWB_Duckwort</defName>
		<label>duckwort</label>
		<description>PLACEHOLDER - grasslike, clusters. Stems with clusters of thin leaves</description>
		<statBases>
			<MaxHitPoints>90</MaxHitPoints>
			<Beauty>4</Beauty>
			<BeautyOutdoors>4</BeautyOutdoors>
			<Nutrition>0.4</Nutrition>
		</statBases>
		<pathCost>18</pathCost>
		<graphicData>
			<texPath>ZWB_Textures/Plants/Duckwort</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<selectable>true</selectable>
		<hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
		<ingestible/>
		<plant>
			<fertilitySensitivity>0.0</fertilitySensitivity>
			<growDays>3.5</growDays>
			<fertilityMin>0.05</fertilityMin>
			<maxMeshCount>9</maxMeshCount>
			<visualSizeRange>0.35~0.8</visualSizeRange>
			<topWindExposure>0.5</topWindExposure>
			<wildClusterRadius>4</wildClusterRadius>
			<wildClusterWeight>200</wildClusterWeight>
			<wildOrder>1</wildOrder>
		</plant>
	</ThingDef>


