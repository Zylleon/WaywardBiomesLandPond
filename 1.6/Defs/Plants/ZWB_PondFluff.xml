<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="PlantBase">
		<defName>ZWB_Pondfluff</defName>
		<label>pondfluff</label>
		<description>A derivative of the common cattail, pondfluff can be harvested for a fluffy textile.</description>
		<neverMultiSelect>false</neverMultiSelect>
		<statBases>
			<MaxHitPoints>70</MaxHitPoints>
			<Nutrition>0.2</Nutrition>
		</statBases>
		<graphicData>
			<texPath>ZWB_Textures/Plants/Pondfluff</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<selectable>true</selectable>
		<pathCost>14</pathCost>
		<ingestible/>
		<plant>
			<fertilityMin>0.5</fertilityMin>
			<fertilitySensitivity>0.85</fertilitySensitivity>
			<immatureGraphicPath>ZWB_Textures/Plants/Pondfluff_Immature</immatureGraphicPath>
			<dieIfLeafless>false</dieIfLeafless>
			<harvestTag>Standard</harvestTag>
			<harvestedThingDef>ZWB_PondfluffCloth</harvestedThingDef>
			<harvestYield>9</harvestYield>
			<topWindExposure>0.2</topWindExposure>
			<visualSizeRange>0.85~1.7</visualSizeRange>
			<maxMeshCount>4</maxMeshCount>
			<wildOrder>3</wildOrder>
			<wildClusterRadius>15</wildClusterRadius>
			<wildClusterWeight>250</wildClusterWeight>
			<mustBeWildToSow>true</mustBeWildToSow>
			<growDays>8</growDays>
			<sowTags>
				<li>Ground</li>
				<li>Hydroponic</li>
			</sowTags>
		</plant>
	</ThingDef>



	<ThingDef ParentName="ResourceBase">
		<defName>ZWB_PondfluffCloth</defName>
		<label>pondfluff</label>
		<description>Fluffy organic fibers.</description>
		<graphicData>
			<texPath>ZWB_Textures/Things/Fabric</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
			<color>(167,162,158)</color>
		</graphicData>
		<statBases>
			<MarketValue>1.9</MarketValue>
			<Mass>0.024</Mass>
			<Flammability>0.9</Flammability>
			<DeteriorationRate>3</DeteriorationRate>
			<StuffPower_Armor_Sharp>0.40</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.05</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>0.2</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>15</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>21</StuffPower_Insulation_Heat>
		</statBases>
		<burnableByRecipe>true</burnableByRecipe>
		<healthAffectsPrice>false</healthAffectsPrice>
		<minRewardCount>30</minRewardCount>
		<stuffProps>
			<categories>
				<li>Fabric</li>
			</categories>
			<commonality>0.20</commonality>
			<color>(167,162,158)</color>
			<statFactors>
				<Flammability>0.27</Flammability>
				<MaxHitPoints>0.85</MaxHitPoints>
				<Beauty>3.5</Beauty>
				<Comfort>1.05</Comfort>
			</statFactors>
		</stuffProps>
		<thingCategories>
			<li>Textiles</li>
		</thingCategories>
		<allowedArchonexusCount>80</allowedArchonexusCount>
	</ThingDef>



</Defs>

