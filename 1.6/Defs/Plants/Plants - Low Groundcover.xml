	<ThingDef ParentName="PlantBase">
		<defName>ZWB_Duckwort</defName>
		<label>duckwort</label>
		<description>PLACEHOLDER - grasslike, clusters. Stems with clusters of thin leaves</description>
		<statBases>
			<MaxHitPoints>90</MaxHitPoints>
			<Beauty>4</Beauty>
			<BeautyOutdoors>4</BeautyOutdoors>
