	<ThingDef ParentName="PlantBase">
		<defName>ZWB_MinnowsTangle</defName>
		<label>minnow's tangle</label>
		<description>PLACEHOLDER - light green, bramble-like, grows in clusters.</description>
		<statBases>
			<MaxHitPoints>90</MaxHitPoints>
			<Nutrition>0.2</Nutrition>
		</statBases>
		<pathCost>18</pathCost>
		<graphicData>
			<texPath>ZWB_Textures/Plants/MinnowsTangle</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
		<ingestible/>
		<plant>
			<fertilitySensitivity>0.0</fertilitySensitivity>
