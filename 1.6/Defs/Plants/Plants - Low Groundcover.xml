<?xml version="1.0" encoding="utf-8"?>
<Defs>


	<ThingDef ParentName="PlantBase">
		<defName>ZWB_MinnowsTangle</defName>
		<label>minnow's tangle</label>
		<description>PLACEHOLDER - light green, bramble-like, grows in clusters.</description>
		<statBases>
			<MaxHitPoints>90</MaxHitPoints>
			<Beauty>4</Beauty>
			<BeautyOutdoors>4</BeautyOutdoors>
			<Nutrition>0.2</Nutrition>
		</statBases>
		<pathCost>18</pathCost>
		<graphicData>
			<texPath>ZWB_Textures/Plants/MinnowsTangle</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
		<ingestible/>
		<plant>
			<fertilitySensitivity>0.0</fertilitySensitivity>
			<growDays>2.5</growDays>
			<fertilityMin>0.05</fertilityMin>
			<maxMeshCount>16</maxMeshCount>
			<visualSizeRange>0.2~.5</visualSizeRange>
			<topWindExposure>0.2</topWindExposure>
			<wildClusterRadius>6</wildClusterRadius>
			<wildClusterWeight>450</wildClusterWeight>
			<wildOrder>1</wildOrder>
		</plant>
	</ThingDef>
	
	
		
	<ThingDef ParentName="PlantBase">
		<defName>ZWB_Siltweed</defName>
		<label>siltweed</label>
